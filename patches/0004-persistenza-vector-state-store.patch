+    # ------------------------------------------------------------------ #
+    # Persistenza                                                          #
+    # ------------------------------------------------------------------ #
+
+    def salva(self, percorso: str | Path | None = None) -> Path:
+        """Scrive lo stato su disco e restituisce il percorso usato.
+
+        Salva SOLO testo e metadati, mai i vettori. L'indice si ricalcola
+        dalla definizione dell'algoritmo (n-grammi di 3 caratteri, TF +
+        coseno): un vettore salvato resterebbe legato all'implementazione
+        che l'ha prodotto, il testo no. Vale anche se un giorno il backend
+        diventasse un modello di embedding — in quel caso il vettore
+        sarebbe leggibile solo finche' esiste quel modello.
+
+        Il file e' deterministico a parita' di contenuto: due salvataggi
+        consecutivi senza scritture intermedie producono byte identici.
+        """
+        p = Path(percorso) if percorso is not None else self._percorso
+        p.parent.mkdir(parents=True, exist_ok=True)
+        dati = {
+            "schema": SCHEMA,
+            "voci": [
+                {"ptr": ptr,
+                 "run_id": self._meta.get(ptr, {}).get("run_id", ""),
+                 "agente_id": self._meta.get(ptr, {}).get("agente_id", ""),
+                 "chiave": self._meta.get(ptr, {}).get("chiave", ""),
+                 "testo": testo}
+                for ptr, testo in self._idx.items()
+            ],
+        }
+        tmp = p.with_suffix(p.suffix + ".tmp")
+        tmp.write_text(json.dumps(dati, ensure_ascii=False, indent=2) + "\n",
+                       encoding="utf-8")
+        tmp.replace(p)       # scrittura atomica: mai un file mezzo scritto
+        return p
+
+    def carica(self, percorso: str | Path | None = None) -> int:
+        """Ripopola lo store da disco. Restituisce il numero di voci lette.
+
+        Idempotente: i pointer gia' presenti non vengono duplicati, cosi'
+        caricare due volte non gonfia la memoria vettoriale.
+        """
+        p = Path(percorso) if percorso is not None else self._percorso
+        try:
+            dati = json.loads(p.read_text(encoding="utf-8"))
+        except (FileNotFoundError, json.JSONDecodeError):
+            return 0
+        if dati.get("schema") != SCHEMA:
+            return 0
+        letti = 0
+        for v in dati.get("voci", []):
+            ptr = v.get("ptr", "")
+            if not ptr or ptr in self._idx:
+                continue
+            self._mem.aggiungi(
+                v.get("testo", ""),
+                metadata={"run_id": v.get("run_id", ""),
+                          "agente_id": v.get("agente_id", ""),
+                          "chiave": v.get("chiave", ""),
+                          "ptr": ptr},
+            )
+            self._idx[ptr] = v.get("testo", "")
+            self._meta[ptr] = {"run_id": v.get("run_id", ""),
+                               "agente_id": v.get("agente_id", ""),
+                               "chiave": v.get("chiave", "")}
+            letti += 1
+        return letti
